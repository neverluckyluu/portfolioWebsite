---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
---

<Layout title="Steven Luu">
	<div class="mx-auto flex max-w-2xl flex-col items-center gap-4 px-6 py-24 text-center">
		<h1 class="text-3xl font-semibold text-stone-900">Steven Luu</h1>
		<p class="text-lg text-stone-600">
			Software Engineer building full-stack tools and games.
		</p>
		<div class="mt-4 flex gap-4">
			<a
				href="/about"
				class="rounded-xl bg-amber-600 px-5 py-2 text-white hover:bg-amber-700"
			>
				About Me
			</a>
			<a
				href="/contact"
				class="rounded-xl border border-stone-300 px-5 py-2 text-stone-800 hover:bg-stone-100"
			>
				Get In Touch
			</a>
		</div>
	</div>

	{
		projects.length > 0 && (
			<div class="mx-auto max-w-3xl px-6 pb-24">
				<h2 class="text-center text-xl font-semibold text-stone-900">
					Featured Projects
				</h2>
				<div class="mt-8 grid gap-6 sm:grid-cols-2">
					{projects.map((project) => (
						<a
							href={`/projects/${project.id}`}
							class="block rounded-xl border border-stone-200 bg-white p-6 hover:border-amber-300 hover:shadow-sm"
						>
							<h3 class="text-lg font-semibold text-stone-900">
								{project.data.title}
							</h3>
							<p class="mt-2 text-stone-600">{project.data.description}</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{project.data.tags.map((tag: string) => (
									<span class="rounded-full bg-stone-100 px-3 py-1 text-sm text-stone-700">
										{tag}
									</span>
								))}
							</div>
						</a>
					))}
				</div>
				<div class="mt-8 text-center">
					<a href="/projects" class="text-amber-700 underline hover:text-amber-800">
						View all projects
					</a>
				</div>
			</div>
		)
	}
</Layout>
