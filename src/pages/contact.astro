---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
	<div class="mx-auto max-w-lg px-6 py-16">
		<h1 class="text-2xl font-semibold text-center text-stone-900">Contact</h1>
		<p class="mt-2 text-center text-stone-600">
			Have a question or want to work together? Send me a message.
		</p>
		<form
			action="https://formspree.io/f/mkjgwjbr"
			method="POST"
			class="mt-8 flex flex-col gap-4"
		>
			<input
				type="text"
				name="_gotcha"
				tabindex="-1"
				autocomplete="off"
				class="hidden"
				aria-hidden="true"
			/>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium text-stone-700">Name</span>
				<input
					type="text"
					name="name"
					required
					class="w-full rounded-xl border border-stone-300 px-3 py-2 focus:border-amber-500 focus:outline-none"
				/>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium text-stone-700">Email</span>
				<input
					type="email"
					name="email"
					required
					class="w-full rounded-xl border border-stone-300 px-3 py-2 focus:border-amber-500 focus:outline-none"
				/>
			</label>
			<label class="flex flex-col gap-1">
				<span class="text-sm font-medium text-stone-700">Message</span>
				<textarea
					name="message"
					rows="5"
					required
					class="w-full rounded-xl border border-stone-300 px-3 py-2 focus:border-amber-500 focus:outline-none"
				></textarea>
			</label>
			<button
				type="submit"
				class="mt-2 rounded-xl bg-amber-600 px-5 py-2 text-white hover:bg-amber-700"
			>
				Send
			</button>
		</form>
	</div>
</Layout>
